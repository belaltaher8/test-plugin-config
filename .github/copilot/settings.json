{
  "enabledPlugins": {
    "belaltaher8/test-plugin-with-agent": true,
    "belaltaher8/test-plugin-with-agent:subdir-plugins/subdir-plugin": true,
    "my-custom-plugin@my-marketplace": true,
    "git-plugin@git-marketplace": true,
    "./local-plugin": true
  },
  "extraKnownMarketplaces": {
    "git-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/belaltaher8/test-marketplace-git.git",
        "ref": "main"
      }
    },
    "my-marketplace": {
      "source": {
        "source": "github",
        "repo": "belaltaher8/test-marketplace",
        "ref": "main"
      }
    }
  }
}
